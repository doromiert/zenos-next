    "notification-timeout@chlumskyvaclav.gmail.com",
    "rounded-window-corners@fxgn",
    "user-theme@gnome-shell-extensions.gcampax.github.com",
    "windowIsReady_Remover@nunofarruca@gmail.com",
    "zenos-oobe-mode@neg-zero.com"
